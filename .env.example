POSTGRES_DB=docforensiq
POSTGRES_USER=docforensiq
POSTGRES_PASSWORD=local-development-only-change-me
JWT_SECRET=replace-this-with-a-random-string-of-at-least-32-characters
FRONTEND_ORIGIN=http://localhost:5173
SELF_REGISTRATION_ENABLED=true
COOKIE_SECURE=false
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=DocForensIQ Admin

# TruFor visual-forensics engine (default off; requires a separately deployed inference
# worker whose license terms have been reviewed before use).
VISUAL_FORENSICS_ENABLED=false
TRUFOR_WORKER_URL=
TRUFOR_MODEL_VERSION=
TRUFOR_CHECKPOINT_SHA256=
TRUFOR_DEVICE=cpu
TRUFOR_MAX_IMAGE_PIXELS=20000000
TRUFOR_RENDER_DPI=200
TRUFOR_JOB_TIMEOUT_SECONDS=120
TRUFOR_MAX_CONCURRENT_PAGES=1
VISUAL_FORENSICS_ARTIFACT_DIR=./private_uploads/visual_artifacts

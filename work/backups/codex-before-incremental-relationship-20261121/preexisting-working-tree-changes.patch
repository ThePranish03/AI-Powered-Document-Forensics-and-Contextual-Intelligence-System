+def _is_pdf_file(path: Path) -> bool:
+    """Recognize PDFs by content because secure upload keys have no suffix."""
+    if path.suffix.lower() == ".pdf":
+        return True
+    try:
+        with path.open("rb") as source:
+            return source.read(5) == b"%PDF-"
+    except OSError:
+        return False

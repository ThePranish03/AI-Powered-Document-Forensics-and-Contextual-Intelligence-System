+def _logical_text(blocks: list[dict]) -> str:
+    """Build search text without counting identical OCR/native blocks twice."""
+    seen: set[str] = set()
+    text: list[str] = []
+    for block in blocks:
+        value = str(block.get("text") or "").strip()
+        key = " ".join(value.casefold().split())
+        if value and key not in seen:
+            seen.add(key)
+            text.append(value)
+    return "\n".join(text)

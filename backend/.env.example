APP_ENV=development
DATABASE_URL=sqlite+aiosqlite:///./docforensiq.db
JWT_SECRET=replace-with-at-least-32-random-characters
FRONTEND_ORIGIN=http://localhost:5173
SELF_REGISTRATION_ENABLED=true
COOKIE_SECURE=false
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
PASSWORD_RESET_MINUTES=30
EMAIL_SINK_FILE=.dev-mailbox.jsonl
DOCUMENT_STORAGE_PATH=./private_uploads
PADDLEOCR_PYTHON=../../extra_things/PaddleOcr/ocr_evaluation/.venv/Scripts/python.exe
# OCR tuning. Mobile OCR models are used by default for speed (~3s/page on CPU).
# Switch to PP-OCRv5_server_det / PP-OCRv5_server_rec for maximum accuracy (~70s/page).
# PADDLEOCR_DET_MODEL=PP-OCRv5_mobile_det
# PADDLEOCR_REC_MODEL=PP-OCRv5_mobile_rec
# PADDLEOCR_LAYOUT_MODEL=PP-DocLayout_plus-L
# Region detection adds minutes per page on CPU; leave disabled unless needed.
# PADDLEOCR_REGION_DETECTION=false
# PADDLEOCR_DOC_ORIENTATION=true
# PADDLEOCR_DOC_UNWARPING=false
# PADDLEOCR_TEXTLINE_ORIENTATION=false
# PADDLEOCR_TABLE_RECOGNITION=false
# PADDLEOCR_FORMULA_RECOGNITION=false
# PADDLEOCR_CHART_RECOGNITION=false
# PADDLEOCR_SEAL_RECOGNITION=false
XAI_API_KEY=
# Cloudflare Workers AI (cfut_... token): base URL is account-scoped.
XAI_BASE_URL=https://api.cloudflare.com/client/v4/accounts/<ACCOUNT_ID>/ai/v1
XAI_MODEL=@cf/meta/llama-4-scout-17b-16e-instruct
# Other Workers AI models that honour strict JSON schema:
# XAI_MODEL=@cf/mistralai/mistral-small-3.1-24b-instruct
# XAI_MODEL=@cf/openai/gpt-oss-120b
# Vercel AI Gateway key (vck_...) instead:
# XAI_BASE_URL=https://ai-gateway.vercel.sh/v1
# XAI_MODEL=spacexai/grok-4.7
# Direct xAI key instead:
# XAI_BASE_URL=https://api.x.ai/v1
# XAI_MODEL=grok-4.7
RELATIONSHIP_EXTRACTION_ENABLED=false
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=DocForensIQ Admin

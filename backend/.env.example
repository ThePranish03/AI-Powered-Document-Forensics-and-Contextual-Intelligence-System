APP_ENV=development
DATABASE_URL=sqlite+aiosqlite:///./docforensiq.db
JWT_SECRET=replace-with-at-least-32-random-characters
FRONTEND_ORIGIN=http://localhost:5173
SELF_REGISTRATION_ENABLED=true
COOKIE_SECURE=false
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
PASSWORD_RESET_MINUTES=30
EMAIL_SINK_FILE=.dev-mailbox.jsonl
DOCUMENT_STORAGE_PATH=./private_uploads
PADDLEOCR_PYTHON=../../extra_things/PaddleOcr/ocr_evaluation/.venv/Scripts/python.exe
# OCR tuning. Mobile OCR models are used by default for speed (~3s/page on CPU).
# Switch to PP-OCRv5_server_det / PP-OCRv5_server_rec for maximum accuracy (~70s/page).
# PADDLEOCR_DET_MODEL=PP-OCRv5_mobile_det
# PADDLEOCR_REC_MODEL=PP-OCRv5_mobile_rec
# PADDLEOCR_LAYOUT_MODEL=PP-DocLayout_plus-L
# Region detection adds minutes per page on CPU; leave disabled unless needed.
# PADDLEOCR_REGION_DETECTION=false
# PADDLEOCR_DOC_ORIENTATION=true
# PADDLEOCR_DOC_UNWARPING=false
# PADDLEOCR_TEXTLINE_ORIENTATION=false
# PADDLEOCR_TABLE_RECOGNITION=false
# PADDLEOCR_FORMULA_RECOGNITION=false
# PADDLEOCR_CHART_RECOGNITION=false
# PADDLEOCR_SEAL_RECOGNITION=false
# Optional Groq provider for relationship extraction and dossier narratives.
RELATIONSHIP_EXTRACTION_ENABLED=false
VISUAL_FORENSICS_ENABLED=false
TRUFOR_LICENSE_CLEARED=false
TRUFOR_WORKER_URL=
TRUFOR_MODEL_VERSION=
TRUFOR_CHECKPOINT_SHA256=
TRUFOR_DEVICE=cpu
# Set true only after intended use and separate checkpoint terms have been cleared.
# Conservative visual-forensics thresholds (invalid/out-of-range values use defaults).
VISUAL_FONT_SIZE_OUTLIER_RATIO=0.62
VISUAL_BASELINE_DEVIATION_PT=2.5
VISUAL_COPY_MOVE_INLIER_RATIO=0.40
VISUAL_JPEG_BLOCKINESS_MIN_EXCESS=4.0
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=DocForensIQ Admin
# Single backend-only LLM provider. Both relationship extraction and dossier
# narratives use this Groq API configuration; workers inherit it from backend/.env.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
LLM_REQUEST_TIMEOUT_SECONDS=240
LLM_RELATIONSHIP_CHUNK_CHARACTERS=4500
LLM_RELATIONSHIP_CHUNK_OVERLAP=400
LLM_RELATIONSHIP_COMPLETION_TOKENS=8192
LLM_CONNECTIVITY_TIMEOUT_SECONDS=240
